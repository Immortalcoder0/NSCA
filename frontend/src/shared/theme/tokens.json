{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NSCA Design Tokens Dictionary",
  "description": "Visual language tokens shared across Frontend UI and Backend PDF Report generators (WeasyPrint/pikepdf)",
  "verdicts": {
    "PASS": {
      "label": "Pass",
      "shortLabel": "PASS",
      "glyph": "check-filled",
      "glyphSymbol": "[✓]",
      "hex": "#10b981",
      "monochrome": {
        "borderStyle": "solid",
        "fillPattern": "solid"
      }
    },
    "PASS_PARTIAL": {
      "label": "Pass (Partial)",
      "shortLabel": "PARTIAL",
      "glyph": "check-warning",
      "glyphSymbol": "[✓!]",
      "hex": "#d97706",
      "monochrome": {
        "borderStyle": "dashed",
        "fillPattern": "striped"
      }
    },
    "PASS_VACUOUS": {
      "label": "Pass (Vacuous)",
      "shortLabel": "VACUOUS",
      "glyph": "check-hollow",
      "glyphSymbol": "(✓)",
      "hex": "#0284c7",
      "monochrome": {
        "borderStyle": "dotted",
        "fillPattern": "hollow"
      }
    },
    "FAIL": {
      "label": "Fail",
      "shortLabel": "FAIL",
      "glyph": "cross-solid",
      "glyphSymbol": "[✗]",
      "hex": "#ef4444",
      "monochrome": {
        "borderStyle": "solid",
        "fillPattern": "solid"
      }
    },
    "UNKNOWN": {
      "label": "Unknown (⊥)",
      "shortLabel": "UNKNOWN",
      "glyph": "question",
      "glyphSymbol": "{?}",
      "hex": "#7c3aed",
      "monochrome": {
        "borderStyle": "double",
        "fillPattern": "shaded"
      }
    },
    "NOT_APPLICABLE": {
      "label": "Not Applicable",
      "shortLabel": "N/A",
      "glyph": "dash",
      "glyphSymbol": "[-]",
      "hex": "#64748b",
      "monochrome": {
        "borderStyle": "dotted",
        "fillPattern": "none"
      }
    }
  },
  "severities": {
    "CRITICAL": {
      "label": "Critical",
      "weight": 5,
      "glyph": "octagon",
      "glyphSymbol": "⯃",
      "hex": "#991b1b",
      "monochrome": {
        "borderThickness": 3,
        "fillPattern": "solid"
      }
    },
    "HIGH": {
      "label": "High",
      "weight": 4,
      "glyph": "diamond",
      "glyphSymbol": "◆",
      "hex": "#ea580c",
      "monochrome": {
        "borderThickness": 2,
        "fillPattern": "crosshatch"
      }
    },
    "MEDIUM": {
      "label": "Medium",
      "weight": 3,
      "glyph": "triangle",
      "glyphSymbol": "▲",
      "hex": "#d97706",
      "monochrome": {
        "borderThickness": 2,
        "fillPattern": "striped"
      }
    },
    "LOW": {
      "label": "Low",
      "weight": 2,
      "glyph": "circle",
      "glyphSymbol": "●",
      "hex": "#2563eb",
      "monochrome": {
        "borderThickness": 1,
        "fillPattern": "dotted"
      }
    },
    "INFORMATIONAL": {
      "label": "Info",
      "weight": 1,
      "glyph": "square",
      "glyphSymbol": "■",
      "hex": "#64748b",
      "monochrome": {
        "borderThickness": 1,
        "fillPattern": "outline"
      }
    }
  },
  "trustTiers": {
    "CERTIFIED": {
      "label": "Certified Rulepack",
      "badgeText": "CERTIFIED",
      "isCertified": true,
      "hex": "#059669"
    },
    "COMMUNITY": {
      "label": "Community Rulepack",
      "badgeText": "COMMUNITY",
      "isCertified": false,
      "hex": "#2563eb"
    },
    "SYNTHESIZED": {
      "label": "Synthesized (AI Learner)",
      "badgeText": "SYNTHESIZED",
      "isCertified": false,
      "hex": "#7c3aed"
    },
    "UNVERIFIED": {
      "label": "Unverified / Custom",
      "badgeText": "UNVERIFIED",
      "isCertified": false,
      "hex": "#d97706"
    }
  }
}
